# Copy this file to .env.local for local development. Never commit real values.

# --- Website (Next.js / Vercel) ---------------------------------------------
# The hub's OWN Convex deployment URL (not MealSync's or Staff's).
NEXT_PUBLIC_CONVEX_URL=

# Used by `npx convex dev` / `npx convex deploy`. For deploying from Vercel,
# use CONVEX_DEPLOY_KEY (the hub project's production deploy key) instead.
CONVEX_DEPLOYMENT=
# CONVEX_DEPLOY_KEY=

# --- Set on the hub's Convex deployment (dashboard -> Settings -> Environment
# Variables, or `npx convex env set NAME value`), NOT in this file ----------
# SITE_URL              The hub's address, e.g. https://hub.example.com. Also the
#                       ticket issuer that Dine, Staff and Crate check (their HUB_ORIGIN).
# JWT_PRIVATE_KEY, JWKS Login signing keys (created automatically by the Vercel build).
# SSO_PRIVATE_KEY       Signs tickets, sync and import requests to the tools. Made by `npm run sso:keys`.
# SEED_ADMIN_NAME       The first master admin's name,
# SEED_ADMIN_PHONE      mobile number
# SEED_ADMIN_PASSWORD   and temporary password (remove it once the admin exists).
